[Unit]
Description=Bergère — private Pi session gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/YOUR_USER/code/bergere
ExecStart=/ABSOLUTE/PATH/TO/node dist/server/main.js
EnvironmentFile=%h/.config/bergere/gateway.env
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
